{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Portable diagnostic run manifest",
  "description": "Template for NEW runs; not a rewrite or validator of heterogeneous historic manifests. Record unavailable evidence explicitly as null.",
  "type": "object",
  "required": ["schema_version", "git_sha", "command", "config", "seed", "unit", "precision", "autocast", "probe_set_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "git_sha": {"$ref": "#/$defs/git_sha"},
    "dirty": {"type": "boolean"},
    "command": {"type": "string", "minLength": 1},
    "config": {"type": "object"},
    "seed": {"type": "integer", "minimum": 0},
    "unit": {"const": "image"},
    "precision": {"type": "string", "minLength": 1},
    "autocast": {"type": "boolean"},
    "tf32": {"type": ["boolean", "null"]},
    "training": {"type": "boolean"},
    "probe_set_sha256": {"$ref": "#/$defs/optional_sha256"},
    "probe_set_description": {"type": "string"},
    "checkpoint_sha256": {"$ref": "#/$defs/optional_sha256"},
    "bootstrap": {"type": ["integer", "object"], "description": "Record estimator, repetitions, seed, missingness policy and paired image-ID alignment; seed uncertainty is not image uncertainty."},
    "source_sha256_before": {"$ref": "#/$defs/hash_map"},
    "source_sha256_after": {"$ref": "#/$defs/hash_map"},
    "source_integrity_unchanged": {"type": "boolean"},
    "num_images": {"type": "integer", "minimum": 0},
    "transform": {"type": ["string", "object"]},
    "semantic_gt_loaded": {"type": "boolean"},
    "checkpoint_policy": {"type": "string"},
    "threshold_grid": {"type": "array", "items": {"type": "number"}},
    "gate_thresholds": {"type": "object"},
    "selection_bias": {"type": ["string", "object"]},
    "multiplicity": {"type": ["string", "object"]},
    "crossfit": {"type": ["string", "object", "boolean", "null"]},
    "environment": {"type": "object"},
    "missing_evidence": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true,
  "$defs": {
    "git_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "optional_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "hash_map": {"type": "object", "additionalProperties": {"$ref": "#/$defs/sha256"}}
  }
}
